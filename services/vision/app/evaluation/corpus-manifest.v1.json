{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifesto de corpus autorizado AquaVision v1",
  "type": "object",
  "required": ["protocolVersion", "corpusId", "authorization", "partitions", "sequences"],
  "properties": {
    "protocolVersion": {"const": "1.0"},
    "corpusId": {"type": "string", "minLength": 1},
    "authorization": {"type": "object", "required": ["owner", "approvedAt", "permittedUse"], "properties": {"owner": {"type": "string"}, "approvedAt": {"type": "string", "format": "date-time"}, "permittedUse": {"type": "string"}}},
    "partitions": {"type": "object", "required": ["pool", "dev", "eval"], "properties": {"pool": {"$ref": "#/$defs/partition"}, "dev": {"$ref": "#/$defs/partition"}, "eval": {"$ref": "#/$defs/partition"}}},
    "sequences": {"type": "array", "items": {"type": "object", "required": ["id", "partition", "scenarios", "pool", "camera", "sourceFps"], "properties": {"id": {"type": "string", "minLength": 1}, "partition": {"enum": ["pool", "dev", "eval"]}, "scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cruzamento", "oclusão", "reflexo", "submersão", "virada", "borda", "câmera_móvel"]}}, "pool": {"type": "string"}, "camera": {"type": "string"}, "sourceFps": {"type": "number", "exclusiveMinimum": 0}}}}
  },
  "$defs": {"partition": {"type": "object", "required": ["sequenceIds", "purpose"], "properties": {"sequenceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "purpose": {"type": "string"}}}}
}
